<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MeuPonto.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F8F7F2</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_brand_glyph</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="postSplashScreenTheme">@style/Theme.MeuPonto</item>
    </style>

    <style name="Theme.MeuPonto" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#157C70</item>
        <item name="android:statusBarColor">#F8F7F2</item>
        <item name="android:navigationBarColor">#F8F7F2</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
